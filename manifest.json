{
  "manifest_version": 3,
  "name": "对话大纲 + 提示词库",
  "version": "1.4.0",
  "description": "为 Claude、ChatGPT、DeepSeek、Gemini、Kimi 和豆包网页版添加多级目录和提示词库。数据保存在本地，可选同步到自己的网盘。",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.doubao.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
